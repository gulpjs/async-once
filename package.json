{
  "name": "async-once",
  "version": "2.0.0",
  "description": "Guarantee a node-style async function is only executed once.",
  "author": "Gulp Team <team@gulpjs.com> (https://gulpjs.com/)",
  "contributors": [
    "Blaine Bublitz <blaine.bublitz@gmail.com>"
  ],
  "funding": "https://github.com/sponsors/gulpjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gulpjs/async-once.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">= 22.15.0"
  },
  "main": "./index.js",
  "files": [
    "LICENSE",
    "index.js"
  ],
  "scripts": {
    "format-check": "prettier . --check",
    "format-write": "prettier . --write",
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "nyc mocha --async-only"
  },
  "dependencies": {
    "@mapbox/basic-queue": "^1.0.1",
    "wrappy": "^1.0.2"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "eslint-config-gulp": "7.0.0",
    "expect": "^27.0.0",
    "mocha": "^8.0.0",
    "nyc": "^15.0.0",
    "prettier": "3.9.6"
  },
  "nyc": {
    "reporter": [
      "lcov",
      "text-summary"
    ]
  },
  "keywords": [
    "once",
    "async",
    "callback",
    "one",
    "time"
  ]
}
